      "out_chars": 11,
      "id": 4,
      "category": "sigh"
    },
    {
      "text_in": "はぁ…びっくりした…",
      "text_out": "哈…吓我一跳…",
      "token_count": 8,
      "prompt_ms": 52.05,
      "pred_ms": 191.08,
      "e2e_ms": 243.13,
      "tokens_per_second": 41.87,
      "chars_per_sec": 28.79,
      "in_chars": 10,
      "out_chars": 7,
      "id": 5,
      "category": "sigh"
    },
    {
      "text_in": "今日もお仕事お疲れ様でした、よく頑張ったね。",
      "text_out": "今天工作辛苦了，你很努力呢。",
      "token_count": 11,
      "prompt_ms": 63.59,
      "pred_ms": 268.66,
      "e2e_ms": 332.25,
      "tokens_per_second": 40.94,
      "chars_per_sec": 42.14,
      "in_chars": 22,
      "out_chars": 14,
      "id": 6,
      "category": "dialogue"
    },
    {
      "text_in": "温かいココアでも淹れてこようか？",
      "text_out": "要我泡杯热可可给你吗？",
      "token_count": 11,
      "prompt_ms": 58.42,
      "pred_ms": 273.81,
      "e2e_ms": 332.23,
      "tokens_per_second": 40.17,
      "chars_per_sec": 33.11,
      "in_chars": 16,
      "out_chars": 11,
      "id": 7,
      "category": "dialogue"
    },
    {
      "text_in": "隣に座ってもいい？少しだけお話ししよう。",
      "text_out": "我可以坐在你旁边吗？我们稍微聊一下吧。",
      "token_count": 13,
      "prompt_ms": 58.5,
      "pred_ms": 326.36,
      "e2e_ms": 384.86,
      "tokens_per_second": 39.83,
      "chars_per_sec": 49.37,
      "in_chars": 20,
      "out_chars": 19,
      "id": 8,
      "category": "dialogue"
    },
    {
      "text_in": "明日も早いんでしょ？無理しちゃだめだよ。",
      "text_out": "明天还要早起吧？不可以勉强自己哦。",
      "token_count": 12,
      "prompt_ms": 64.03,
      "pred_ms": 295.75,
      "e2e_ms": 359.78,
      "tokens_per_second": 40.58,
      "chars_per_sec": 47.25,
      "in_chars": 20,
      "out_chars": 17,
      "id": 9,
      "category": "dialogue"
    },
    {
      "text_in": "ぎゅーって抱きしめてあげるから、安心してね。",
      "text_out": "我会紧紧抱住你的，放心吧。",
      "token_count": 9,
      "prompt_ms": 64.23,
      "pred_ms": 217.25,
      "e2e_ms": 281.48,
      "tokens_per_second": 41.43,
      "chars_per_sec": 46.18,
      "in_chars": 22,
      "out_chars": 13,
      "id": 10,
      "category": "dialogue"
    },
    {
      "text_in": "頭をなでなでしてあげるね、いい子いい子…",
      "text_out": "我摸摸你的头，好乖好乖……",
      "token_count": 12,
      "prompt_ms": 63.01,
      "pred_ms": 297.67,
      "e2e_ms": 360.68,
      "tokens_per_second": 40.31,
      "chars_per_sec": 36.04,
      "in_chars": 20,
      "out_chars": 13,
      "id": 11,
      "category": "dialogue"
    },
    {
      "text_in": "あなたの優しい笑顔、私大好きだよ。",
      "text_out": "我最喜欢你温柔的笑容了。",
      "token_count": 8,
      "prompt_ms": 63.18,
      "pred_ms": 189.98,
      "e2e_ms": 253.16,
      "tokens_per_second": 42.11,
      "chars_per_sec": 47.4,
      "in_chars": 17,
      "out_chars": 12,
      "id": 12,
      "category": "dialogue"
    },
    {
      "text_in": "ずっとそばにいるから、目を閉じてゆっくり深呼吸してね。",
      "text_out": "我会一直陪在你身边，所以闭上眼睛慢慢深呼吸。",
      "token_count": 16,
      "prompt_ms": 57.11,
      "pred_ms": 408.51,
      "e2e_ms": 465.62,
      "tokens_per_second": 39.17,
      "chars_per_sec": 47.25,
      "in_chars": 27,
      "out_chars": 22,
      "id": 13,
      "category": "dialogue"
    },
    {
      "text_in": "今日も一日、本当によく頑張ったね。",
      "text_out": "你今天一整天真的都很努力呢。",
      "token_count": 10,
      "prompt_ms": 66.56,
      "pred_ms": 240.74,
      "e2e_ms": 307.3,
      "tokens_per_second": 41.54,
      "chars_per_sec": 45.56,
      "in_chars": 17,
      "out_chars": 14,
      "id": 14,
      "category": "dialogue"
    },
    {
      "text_in": "大丈夫、私がずっとついてるからね。",
      "text_out": "放心，我会一直陪着你的。",
      "token_count": 8,
      "prompt_ms": 56.05,
      "pred_ms": 191.94,
      "e2e_ms": 247.98,
      "tokens_per_second": 41.68,
      "chars_per_sec": 48.39,
      "in_chars": 17,
      "out_chars": 12,
      "id": 15,
      "category": "dialogue"
    },
    {
      "text_in": "今日は外がすごく寒かったから、お風呂にゆっくり浸かって、温かいお布団に入ってぐっすり休んでね。",
      "text_out": "今天外面很冷，所以要慢慢泡澡，然后钻进温暖的被窝好好休息哦。",
      "token_count": 23,
      "prompt_ms": 69.51,
      "pred_ms": 586.7,
      "e2e_ms": 656.2,
      "tokens_per_second": 39.2,
      "chars_per_sec": 45.72,
      "in_chars": 47,
      "out_chars": 30,
      "id": 16,
      "category": "compound"
    },
    {
      "text_in": "いつも誰よりも一生懸命頑張っているのを見てるから、今夜くらいは思いっきり甘えて泣いちゃってもいいんだよ？",
      "text_out": "我总是看着你比任何人都努力，所以今晚你可以尽情地向我撒娇哭泣哦？",
      "token_count": 21,
      "prompt_ms": 65.74,
      "pred_ms": 534.26,
      "e2e_ms": 600.0,
      "tokens_per_second": 39.31,
      "chars_per_sec": 53.33,
      "in_chars": 52,
      "out_chars": 32,
      "id": 17,
      "category": "compound"
    },
    {
      "text_in": "耳元で囁かれるのってちょっとくすぐったいかもしれないけど、息を吹きかけながらいっぱい癒してあげるね。",
      "text_out": "在耳边低语可能会有点痒，但我会一边吹气，一边好好地治愈你的。",
      "token_count": 21,
      "prompt_ms": 64.6,
      "pred_ms": 538.8,
      "e2e_ms": 603.4,
      "tokens_per_second": 38.98,
      "chars_per_sec": 49.72,
      "in_chars": 50,
      "out_chars": 30,
      "id": 18,
      "category": "compound"
    },
    {
      "text_in": "本当は私もすごく緊張しててドキドキしてるんだけど、君の手を握ると不思議と落ち着くんだ。",
      "text_out": "其实我也非常紧张，心脏扑通扑通地跳个不停，但不可思议的是，一握住你的手就冷静下来了。",
      "token_count": 29,
      "prompt_ms": 64.51,
      "pred_ms": 764.59,
      "e2e_ms": 829.1,
      "tokens_per_second": 37.93,
      "chars_per_sec": 50.66,
      "in_chars": 43,
      "out_chars": 42,
      "id": 19,
      "category": "compound"
    },
    {
      "text_in": "眠れないなら朝までずっとお話ししていようか、君が眠くなるまで何時間でも付き合うからね。",
      "text_out": "既然睡不着，那就聊到天亮吧。我会陪你好几个小时，直到你想睡为止。",
      "token_count": 23,
      "prompt_ms": 62.77,
      "pred_ms": 590.5,
      "e2e_ms": 653.27,
      "tokens_per_second": 38.95,
      "chars_per_sec": 48.98,
      "in_chars": 43,
      "out_chars": 32,
      "id": 20,
      "category": "compound"
    }
  ],
