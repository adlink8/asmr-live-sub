    },
    {
      "text_in": "ん…もう、意地悪…",
      "text_out": "嗯…真是的，好坏心眼…",
      "token_count": 11,
      "prompt_ms": 52.95,
      "pred_ms": 275.17,
      "e2e_ms": 328.12,
