      "id": 5,
      "category": "sigh"
    },
    {
      "text_in": "今日もお仕事お疲れ様でした、よく頑張ったね。",
      "text_out": "今天工作辛苦了，你很努力呢。",
      "prompt_ms": 65.14,
      "pred_ms": 260.85,
      "e2e_ms": 325.99,
      "chars_per_sec": 42.95,
      "in_chars": 22,
      "out_chars": 14,
      "id": 6,
      "category": "dialogue"
    },
    {
      "text_in": "温かいココアでも淹れてこようか？",
      "text_out": "要我泡杯热可可给你吗？",
      "prompt_ms": 62.83,
      "pred_ms": 252.77,
      "e2e_ms": 315.6,
      "chars_per_sec": 34.85,
      "in_chars": 16,
      "out_chars": 11,
      "id": 7,
      "category": "dialogue"
    },
    {
      "text_in": "隣に座ってもいい？少しだけお話ししよう。",
      "text_out": "我可以坐在你旁边吗？我们稍微聊一下吧。",
      "prompt_ms": 63.71,
      "pred_ms": 306.02,
      "e2e_ms": 369.74,
      "chars_per_sec": 51.39,
      "in_chars": 20,
      "out_chars": 19,
      "id": 8,
      "category": "dialogue"
    },
    {
      "text_in": "明日も早いんでしょ？無理しちゃだめだよ。",
      "text_out": "明天还要早起吧？不可以勉强自己哦。",
      "prompt_ms": 63.97,
      "pred_ms": 284.56,
      "e2e_ms": 348.53,
      "chars_per_sec": 48.78,
      "in_chars": 20,
      "out_chars": 17,
      "id": 9,
      "category": "dialogue"
    },
    {
      "text_in": "ぎゅーって抱きしめてあげるから、安心してね。",
      "text_out": "我会紧紧抱住你的，放心吧。",
      "prompt_ms": 64.01,
      "pred_ms": 207.14,
      "e2e_ms": 271.15,
      "chars_per_sec": 47.94,
      "in_chars": 22,
      "out_chars": 13,
      "id": 10,
      "category": "dialogue"
    },
    {
      "text_in": "頭をなでなでしてあげるね、いい子いい子…",
      "text_out": "我摸摸你的头，好乖好乖……",
      "prompt_ms": 68.49,
      "pred_ms": 279.27,
      "e2e_ms": 347.76,
      "chars_per_sec": 37.38,
      "in_chars": 20,
      "out_chars": 13,
      "id": 11,
      "category": "dialogue"
    },
    {
      "text_in": "あなたの優しい笑顔、私大好きだよ。",
      "text_out": "我最喜欢你温柔的笑容了。",
      "prompt_ms": 66.99,
      "pred_ms": 177.82,
      "e2e_ms": 244.8,
      "chars_per_sec": 49.02,
      "in_chars": 17,
      "out_chars": 12,
      "id": 12,
      "category": "dialogue"
    },
    {
      "text_in": "ずっとそばにいるから、目を閉じてゆっくり深呼吸してね。",
      "text_out": "我会一直陪在你身边，所以闭上眼睛慢慢深呼吸。",
      "prompt_ms": 64.46,
      "pred_ms": 385.44,
      "e2e_ms": 449.9,
      "chars_per_sec": 48.9,
      "in_chars": 27,
      "out_chars": 22,
      "id": 13,
      "category": "dialogue"
    },
    {
      "text_in": "今日も一日、本当によく頑張ったね。",
      "text_out": "你今天也真的非常努力呢。",
      "prompt_ms": 64.84,
      "pred_ms": 203.64,
      "e2e_ms": 268.48,
      "chars_per_sec": 44.7,
      "in_chars": 17,
      "out_chars": 12,
      "id": 14,
      "category": "dialogue"
    },
    {
      "text_in": "今日は外がすごく寒かったから、",
      "text_out": "今天外面非常冷。",
      "prompt_ms": 61.17,
      "pred_ms": 127.66,
      "e2e_ms": 188.83,
      "chars_per_sec": 42.37,
      "in_chars": 15,
      "out_chars": 8,
      "id": 15,
      "category": "compound_1"
    },
    {
      "text_in": "お風呂にゆっくり浸かって、",
      "text_out": "悠哉地泡在浴缸里。",
      "prompt_ms": 60.98,
      "pred_ms": 233.11,
      "e2e_ms": 294.09,
      "chars_per_sec": 30.6,
      "in_chars": 13,
      "out_chars": 9,
      "id": 16,
      "category": "compound_1"
    },
    {
      "text_in": "温かいお布団に入ってぐっすり休んでね。",
      "text_out": "快点钻进温暖的被窝好好休息吧。",
      "prompt_ms": 64.52,
      "pred_ms": 304.93,
      "e2e_ms": 369.45,
      "chars_per_sec": 40.6,
      "in_chars": 19,
      "out_chars": 15,
      "id": 17,
      "category": "compound_1"
    },
    {
      "text_in": "いつも誰よりも一生懸命頑張っているのを見てるから…",
      "text_out": "因为我一直看着她比任何人都要拼命努力的样子…",
      "prompt_ms": 65.63,
      "pred_ms": 279.51,
      "e2e_ms": 345.14,
      "chars_per_sec": 63.74,
      "in_chars": 25,
      "out_chars": 22,
      "id": 18,
      "category": "compound_2"
    },
    {
      "text_in": "今夜くらいは私の前で、",
      "text_out": "至少今晚，在我面前——",
      "prompt_ms": 62.39,
      "pred_ms": 156.46,
      "e2e_ms": 218.84,
      "chars_per_sec": 50.26,
      "in_chars": 11,
      "out_chars": 11,
      "id": 19,
      "category": "compound_2"
    },
    {
      "text_in": "思いっきり甘えて泣いちゃってもいいんだよ？",
      "text_out": "你可以尽情地向我撒娇哭泣哦？",
      "prompt_ms": 63.91,
      "pred_ms": 255.53,
      "e2e_ms": 319.44,
      "chars_per_sec": 43.83,
      "in_chars": 21,
      "out_chars": 14,
      "id": 20,
      "category": "compound_2"
    },
    {
      "text_in": "耳元で囁かれるのってちょっとくすぐったいかもしれないけど、",
      "text_out": "在耳边低语，或许会让人觉得有点痒。",
      "prompt_ms": 64.5,
      "pred_ms": 308.24,
      "e2e_ms": 372.74,
      "chars_per_sec": 45.61,
      "in_chars": 29,
      "out_chars": 17,
      "id": 21,
      "category": "compound_3"
    },
    {
      "text_in": "息を吹きかけながら、",
      "text_out": "一边吹着气，",
      "prompt_ms": 63.59,
      "pred_ms": 130.48,
      "e2e_ms": 194.07,
      "chars_per_sec": 30.92,
      "in_chars": 10,
      "out_chars": 6,
      "id": 22,
      "category": "compound_3"
    },
    {
      "text_in": "いっぱい癒してあげるね。",
      "text_out": "我会好好地治愈你的。",
      "prompt_ms": 61.38,
      "pred_ms": 156.43,
      "e2e_ms": 217.8,
      "chars_per_sec": 45.91,
      "in_chars": 12,
      "out_chars": 10,
      "id": 23,
      "category": "compound_3"
    },
    {
      "text_in": "本当は私もすごく緊張してて、",
      "text_out": "其实我也非常紧张。",
      "prompt_ms": 62.68,
      "pred_ms": 131.55,
      "e2e_ms": 194.23,
      "chars_per_sec": 46.34,
      "in_chars": 14,
      "out_chars": 9,
      "id": 24,
      "category": "compound_4"
    },
    {
      "text_in": "心臓がドキドキしてるんだけど…",
      "text_out": "心脏扑通扑通地跳个不停……",
      "prompt_ms": 64.11,
      "pred_ms": 257.54,
      "e2e_ms": 321.65,
      "chars_per_sec": 40.42,
      "in_chars": 15,
      "out_chars": 13,
      "id": 25,
      "category": "compound_4"
    },
    {
      "text_in": "君の手を握ると不思議と落ち着くんだ。",
      "text_out": "握住你的手，就会不可思议地冷静下来。",
      "prompt_ms": 65.12,
      "pred_ms": 260.56,
      "e2e_ms": 325.68,
      "chars_per_sec": 55.27,
      "in_chars": 18,
