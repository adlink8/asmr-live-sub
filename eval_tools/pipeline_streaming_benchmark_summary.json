      "ttft_reduction_pct": 87.21,
      "tokens_per_second": 42.32
    },
    {
      "id": 8,
      "category": "dialogue",
      "ja": "隣に座ってもいい？少しだけお話ししよう。",
      "zh": "我可以坐在你旁边吗？我们稍微聊一下吧。",
      "first_token": "我可以",
      "token_count": 13,
      "time_to_first_token_ms": 36.88,
      "full_completion_latency_ms": 319.58,
      "pred_decode_ms": 282.7,
      "ttft_reduction_pct": 88.46,
      "tokens_per_second": 42.45
    },
    {
      "id": 9,
      "category": "dialogue",
      "ja": "明日も早いんでしょ？無理しちゃだめだよ。",
      "zh": "明天还要早起吧？不可以勉强自己哦。",
      "first_token": "明天",
      "token_count": 12,
      "time_to_first_token_ms": 37.23,
      "full_completion_latency_ms": 294.71,
      "pred_decode_ms": 257.48,
      "ttft_reduction_pct": 87.37,
      "tokens_per_second": 42.72
    },
    {
      "id": 10,
      "category": "dialogue",
      "ja": "ぎゅーって抱きしめてあげるから、安心してね。",
      "zh": "我会紧紧抱住你的，放心吧。",
      "first_token": "我会",
      "token_count": 9,
      "time_to_first_token_ms": 36.31,
      "full_completion_latency_ms": 223.53,
      "pred_decode_ms": 187.23,
      "ttft_reduction_pct": 83.76,
      "tokens_per_second": 42.73
    },
    {
      "id": 11,
      "category": "dialogue",
      "ja": "頭をなでなでしてあげるね、いい子いい子…",
      "zh": "我摸摸你的头，好乖好乖……",
      "first_token": "我",
      "token_count": 12,
      "time_to_first_token_ms": 36.93,
      "full_completion_latency_ms": 296.56,
      "pred_decode_ms": 259.63,
      "ttft_reduction_pct": 87.55,
      "tokens_per_second": 42.37
    },
    {
      "id": 12,
      "category": "dialogue",
      "ja": "あなたの優しい笑顔、私大好きだよ。",
      "zh": "我最喜欢你温柔的笑容了。",
      "first_token": "我",
      "token_count": 8,
      "time_to_first_token_ms": 36.47,
      "full_completion_latency_ms": 202.38,
      "pred_decode_ms": 165.9,
      "ttft_reduction_pct": 81.98,
      "tokens_per_second": 42.19
    },
    {
      "id": 13,
      "category": "dialogue",
      "ja": "ずっとそばにいるから、目を閉じてゆっくり深呼吸してね。",
      "zh": "我会一直陪在你身边，所以闭上眼睛慢慢深呼吸。",
      "first_token": "我会",
      "token_count": 16,
      "time_to_first_token_ms": 36.46,
      "full_completion_latency_ms": 388.02,
      "pred_decode_ms": 351.57,
      "ttft_reduction_pct": 90.6,
      "tokens_per_second": 42.67
    },
    {
      "id": 14,
      "category": "dialogue",
      "ja": "今日も一日、本当によく頑張ったね。",
      "zh": "你今天也真的非常努力呢。",
      "first_token": "你",
      "token_count": 9,
      "time_to_first_token_ms": 33.79,
      "full_completion_latency_ms": 220.93,
      "pred_decode_ms": 187.14,
      "ttft_reduction_pct": 84.7,
      "tokens_per_second": 42.75
    },
    {
      "id": 15,
      "category": "dialogue",
      "ja": "大丈夫、私がずっとついてるからね。",
      "zh": "放心，我会一直陪着你的。",
      "first_token": "放心",
      "token_count": 8,
      "time_to_first_token_ms": 50.51,
      "full_completion_latency_ms": 220.02,
      "pred_decode_ms": 169.5,
      "ttft_reduction_pct": 77.04,
      "tokens_per_second": 41.3
    },
    {
      "id": 16,
      "category": "compound",
      "ja": "今日は外がすごく寒かったから、お風呂にゆっくり浸かって、温かいお布団に入ってぐっすり休んでね。",
      "zh": "今天外面很冷，所以要慢慢泡澡，然后钻进温暖的被窝好好休息哦。",
      "first_token": "今天",
      "token_count": 23,
      "time_to_first_token_ms": 42.16,
      "full_completion_latency_ms": 560.77,
      "pred_decode_ms": 518.61,
      "ttft_reduction_pct": 92.48,
      "tokens_per_second": 42.42
    },
    {
      "id": 17,
      "category": "compound",
      "ja": "いつも誰よりも一生懸命頑張っているのを見てるから、今夜くらいは思いっきり甘えて泣いちゃってもいいんだよ？",
      "zh": "我总是看着你比任何人都努力，所以今晚你可以尽情地向我撒娇哭泣哦？",
      "first_token": "我",
      "token_count": 21,
      "time_to_first_token_ms": 40.76,
      "full_completion_latency_ms": 513.89,
      "pred_decode_ms": 473.13,
      "ttft_reduction_pct": 92.07,
      "tokens_per_second": 42.27
    },
    {
      "id": 18,
      "category": "compound",
      "ja": "耳元で囁かれるのってちょっとくすぐったいかもしれないけど、息を吹きかけながらいっぱい癒してあげるね。",
      "zh": "在耳边低语可能会有点痒，但我会一边吹气，一边好好地治愈你的。",
      "first_token": "在",
      "token_count": 21,
      "time_to_first_token_ms": 40.03,
      "full_completion_latency_ms": 502.64,
      "pred_decode_ms": 462.61,
      "ttft_reduction_pct": 92.04,
      "tokens_per_second": 43.23
    },
    {
      "id": 19,
      "category": "compound",
      "ja": "本当は私もすごく緊張しててドキドキしてるんだけど、君の手を握ると不思議と落ち着くんだ。",
      "zh": "其实我也非常紧张，心脏跳得飞快，但不可思议的是，握住你的手后就冷静下来了。",
      "first_token": "其实",
      "token_count": 25,
      "time_to_first_token_ms": 40.56,
      "full_completion_latency_ms": 603.49,
      "pred_decode_ms": 562.93,
      "ttft_reduction_pct": 93.28,
      "tokens_per_second": 42.63
    },
    {
      "id": 20,
      "category": "compound",
      "ja": "眠れないなら朝までずっとお話ししていようか、君が眠くなるまで何時間でも付き合うからね。",
      "zh": "既然睡不着，那就聊到天亮吧。我会陪你好几个小时，直到你想睡为止。",
      "first_token": "既然",
