  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 0.81,
      "t1": 7.92,
      "zh": "不要紧...黑暗对大家同等的温柔哦...|26...25..."
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 7.92,
      "t1": 12.2,
      "zh": "可爱的人类|24...23..."
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 12.2,
      "t1": 18.13,
      "zh": "如此简单地堕入埃姆登之中...|22...21..."
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 18.13,
      "t1": 27.83,
      "zh": "这样就好...这就是你的幸福...|20...19..."
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 27.83,
      "t1": 36.87,
      "zh": "五感和意识都混沌不清...|18...17..."
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 36.87,
      "t1": 49.5,
      "zh": "唯一的清晰是埃姆登的存在...|16...15...14..."
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 49.5,
      "t1": 57.49,
      "zh": "人类只要有埃姆登便好...|13...12..."
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 57.49,
      "t1": 66.54,
      "zh": "黑暗中这是唯一温柔存在的，坚定不移的事实...|11...10..."
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 66.54,
      "t1": 76.58,
      "zh": "吸气...呼气……"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 76.58,
      "t1": 89.03,
      "zh": "马上...等数到0，你就会陷入沉睡"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 89.03,
      "t1": 102.39,
      "zh": "下次醒来时，人类会自然地渴望埃姆登"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 102.39,
      "t1": 112.75,
      "zh": "然后和人类相呼应一般，埃姆登又会觉醒"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 112.75,
      "t1": 119.29,
      "zh": "渴望埃姆登吧...人类..."
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 119.29,
      "t1": 124.45,
      "zh": "臣服于埃姆登..."
    },
