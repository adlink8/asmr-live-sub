  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 1.91,
      "t1": 5.49,
      "zh": "嗨，欢迎光临，我的男朋友"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 6.55,
      "t1": 9.29,
      "zh": "这是你女朋友的房间哦～"
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 9.34,
      "t1": 14.85,
      "zh": "怎么样？作为男朋友进我的房间，有什么感想"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 18.02,
      "t1": 20.09,
      "zh": "和以前没什么变化吧"
