  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 0.87,
      "t1": 3.4,
      "zh": "啊~，你醒啦"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 3.4,
      "t1": 6.15,
      "zh": "早上好"
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 6.15,
      "t1": 10.37,
      "zh": "呐，你戴着的耳机"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 10.37,
      "t1": 15.5,
      "zh": "你一直都是听着这种东西睡觉的吗"
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 15.5,
      "t1": 19.3,
      "zh": "好像是叫ASMR音声吧"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 19.3,
      "t1": 22.67,
      "zh": "原来你喜欢这种啊"
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 22.67,
      "t1": 26.1,
      "zh": "嗯？啊~，对了"
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 26.1,
      "t1": 29.52,
      "zh": "我还没有自我介绍吧"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 29.52,
      "t1": 36.65,
      "zh": "我是从魔界来的恶魔女王 周防パトラ"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 36.65,
      "t1": 42.02,
      "zh": "今天是为了了解人类才从魔界过来的"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 42.02,
      "t1": 46.42,
      "zh": "类似与为了成为杰出女王的测验"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 46.42,
      "t1": 49.95,
      "zh": "想要了解人类的生态"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 49.95,
      "t1": 55.67,
      "zh": "或者说是来研究人类在什么状态下会被治愈"
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 55.67,
      "t1": 59.5,
      "zh": "然后你就被幸运地选中了"
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 59.5,
      "t1": 63.57,
      "zh": "但是因为你一直在睡所以我就等你醒过来了"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 63.57,
      "t1": 67.07,
      "zh": "嗯？说的也是"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 67.07,
      "t1": 70.45,
      "zh": "说到要做什么的话"
    },
    {
      "idx": 18,
      "seg_id": 18,
      "t0": 70.45,
      "t1": 77.72,
      "zh": "比如说 呼——"
    },
    {
      "idx": 19,
      "seg_id": 19,
      "t0": 77.72,
      "t1": 82.22,
      "zh": "像你喜欢的这部音声"
    },
    {
      "idx": 20,
      "seg_id": 20,
      "t0": 82.22,
      "t1": 87.72,
      "zh": "做和它一样的事情可以吗？"
    },
    {
      "idx": 21,
      "seg_id": 21,
      "t0": 87.72,
      "t1": 98.87,
      "zh": "实际体验一定会非常舒服，一定会被治愈"
    },
    {
      "idx": 22,
      "seg_id": 22,
      "t0": 98.87,
      "t1": 105.4,
      "zh": "其实我一直想试试做这种事情"
    },
    {
      "idx": 23,
      "seg_id": 23,
      "t0": 105.4,
      "t1": 115.35,
      "zh": "玩弄耳朵、或是像这样给人类的身体按摩"
    },
    {
      "idx": 24,
      "seg_id": 24,
      "t0": 115.35,
      "t1": 119.32,
      "zh": "呐…不行吗？"
    },
    {
      "idx": 25,
      "seg_id": 25,
      "t0": 119.32,
      "t1": 127.47,
      "zh": "我想玩弄你的身体，用你来做实验呢"
    },
    {
      "idx": 26,
      "seg_id": 26,
      "t0": 127.47,
      "t1": 132.22,
      "zh": "嗯？真的？谢谢~"
    },
    {
      "idx": 27,
      "seg_id": 27,
      "t0": 132.22,
      "t1": 134.12,
      "zh": "那么事不宜迟"
    },
    {
      "idx": 28,
      "seg_id": 28,
      "t0": 134.12,
      "t1": 137.12,
      "zh": "恶魔女王的治愈研究，开始吧~"
    }
  ]
}