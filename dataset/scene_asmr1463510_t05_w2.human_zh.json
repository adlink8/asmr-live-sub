{
  "script_file": "Tr05_循環用音源.wav.vtt",
  "source": "dlsite_builtin_vtt",
  "total_segments": 20,
  "built_at": "2026-09-25 09:12:30",
  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 22.54,
      "t1": 26.69,
      "zh": "只有右邊的話，還得不到期望中的答案呢。"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 28.06,
      "t1": 32.17,
      "zh": "那麼接下來，該輪到另一邊囉。"
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 34.71,
      "t1": 35.95,
      "zh": "哎呀、哎呀"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 36.7,
      "t1": 39.06,
      "zh": "居然這麼的熱衷，"
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 40.07,
      "t1": 44.02,
      "zh": "果然無法抗拒快樂嗎？"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 47.14,
      "t1": 49.91,
      "zh": "你這是何等的貪婪呀。"
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 51.35,
      "t1": 52.35,
      "zh": "不過，"
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 53.18,
      "t1": 54.69,
      "zh": "我並不討厭喔。"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 55.72,
      "t1": 57.2,
      "zh": "惹人憐愛..."
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 58.11,
      "t1": 62.88,
      "zh": "正是因為醜陋且脆弱，才顯得出你美麗。"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 127.08,
      "t1": 131.58,
      "zh": "美好的音色...從你的深處迴響出來。"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 133.14,
      "t1": 136.51,
      "zh": "我的觸手在肉體中回響。"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 137.87,
      "t1": 141.93,
      "zh": "這個聲音會告訴我一切。"
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 143.19,
      "t1": 145.15,
      "zh": "這是喜悅的聲音。"
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 146.57,
      "t1": 149.52,
      "zh": "是你我協奏的旋律。"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 154.1,
      "t1": 160.94,
      "zh": "快樂，是越重複越會陷入的深淵，無法自拔。"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 162.89,
      "t1": 165.93,
      "zh": "我見過太多那樣的人類了。"
    },
    {
      "idx": 18,
      "seg_id": 18,
      "t0": 170.89,
      "t1": 174.89,
      "zh": "即便是殺戮，也能轉變成快樂。"
    },
    {
      "idx": 19,
      "seg_id": 19,
      "t0": 175.74,
      "t1": 177.41,
      "zh": "那便是人類。"
    },
    {
      "idx": 20,
      "seg_id": 20,
      "t0": 179.52,
      "t1": 183.3,
      "zh": "戰爭無法消失也是因為這樣的原因。"
    }
  ],
