    {
      "idx": 26,
      "seg_id": 26,
      "t0": 174.83,
      "t1": 179.08,
      "zh": "我接下来要帮哥哥掏耳喔♪"
    },
    {
      "idx": 27,
      "seg_id": 27,
      "t0": 179.56,
      "t1": 182.23,
      "zh": "你就在那躺下吧"
