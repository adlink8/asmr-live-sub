  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 8.61,
      "t1": 12.21,
      "zh": "哈啊... 累死我了..."
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 13.75,
      "t1": 21.53,
      "zh": "母亲大人真是会使唤人啊... 这样会让我心生厌恶的..."
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 22.92,
      "t1": 28.19,
      "zh": "在这里的话... 就算我独自待着应该也不会被骂的吧?"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 31.12,
      "t1": 35.83,
      "zh": "啊... 说起来这个地方是..."
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 36.96,
      "t1": 41.78,
      "zh": "啊...! 我想起来了 果然是这里啊...!"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 42.25,
      "t1": 45.4,
      "zh": "啊 那东西不知道还在不在呢..."
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 46.93,
      "t1": 52.78,
      "zh": "让我找找... 我记得应该是在这里的第三层里..."
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 58.33,
      "t1": 61.63,
      "zh": "果然! 找到棉花棒了!"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 62.62,
      "t1": 66.72,
      "zh": "啊! 还剩下了几根呢"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 68.7,
      "t1": 74.8,
      "zh": "要是兄长有在这里的话 我就能为他掏耳了啊..."
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 76.73,
      "t1": 82.08,
      "zh": "啊... 不过那也是不可能的呢..."
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 86.8,
      "t1": 89.4,
      "zh": "感觉好寂寞啊..."
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 95.18,
      "t1": 101.83,
      "zh": "我从来都没想过... 这样的一天会到来呢..."
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 102.87,
      "t1": 107.49,
      "zh": "记得我第一次为兄长掏耳的时候..."
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 115.44,
      "t1": 120.62,
      "zh": "哥哥你在做什么啊~ 快点快点~♪"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 122.14,
      "t1": 125.62,
      "zh": "来吧哥哥 你快来躺在这里嘛♪"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 126.79,
      "t1": 131.74,
      "zh": "嗯! 对啊~ 这个坐垫是我  排好的喔~♪"
    },
    {
      "idx": 18,
      "seg_id": 18,
      "t0": 133.0,
      "t1": 134.82,
      "zh": "我做得很好对吧♪"
    },
    {
      "idx": 19,
      "seg_id": 19,
      "t0": 137.21,
      "t1": 141.03,
      "zh": "啊 你问接下来是要做什么吗?"
    },
    {
      "idx": 20,
      "seg_id": 20,
      "t0": 141.67,
      "t1": 146.57,
      "zh": "这个嘛... 你先我等一下"
    },
    {
      "idx": 21,
      "seg_id": 21,
      "t0": 147.61,
      "t1": 151.58,
      "zh": "让我找找... 放到哪去了啊..."
    },
    {
      "idx": 22,
      "seg_id": 22,
      "t0": 153.25,
      "t1": 159.32,
      "zh": "明明父亲有说过是放在这个抽屉里的..."
    },
    {
      "idx": 23,
      "seg_id": 23,
      "t0": 159.8,
      "t1": 161.75,
      "zh": "啊! 找到了!"
    },
    {
      "idx": 24,
      "seg_id": 24,
      "t0": 164.25,
      "t1": 167.1,
      "zh": "哥哥你看 这个啊..."
