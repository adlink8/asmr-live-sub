  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 6.22,
      "t1": 11.9,
      "zh": "总之…这边的耳朵清理算是结束了…"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 12.92,
      "t1": 23.72,
      "zh": "难得挖耳勺还在手上…我想再做点能放松的事情…"
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 26.17,
      "t1": 29.03,
      "zh": "你知道梵天吗…？"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 29.82,
      "t1": 35.72,
      "zh": "就是挖耳勺后面的…软绵绵的这个…"
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 36.52,
      "t1": 41.53,
      "zh": "本来是用于扫掉清洁出来的污垢…"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 42.21,
      "t1": 46.97,
      "zh": "但现在用了棉签…本来没有使用的必要…"
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 48.44,
      "t1": 55.65,
      "zh": "但是…我很喜欢被这个抚弄耳朵的感觉…很舒服…"
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 57.05,
      "t1": 60.99,
      "zh": "所以我也想给你试试…"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 66.98,
      "t1": 68.33,
      "zh": "可以吧…？"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 71.57,
      "t1": 76.44,
      "zh": "那么…要使用梵天了哦…？"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 89.46,
      "t1": 93.1,
      "zh": "真的…只是在抚弄而已呢…"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 104.14,
      "t1": 106.28,
      "zh": "里面也要…"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 113.08,
      "t1": 115.26,
      "zh": "深处也要…来一下…"
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 126.35,
      "t1": 129.96,
      "zh": "最后…再整体地…"
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 143.73,
      "t1": 146.73,
      "zh": "这样…梵天的环节也结束了…"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 149.66,
      "t1": 156.47,
      "zh": "能做这个真是太好了…能感觉到你变得更加放松了…"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 162.99,
      "t1": 170.14,
      "zh": "虽然在开始掏耳朵之前…我说过在掏耳朵的途中…或许能习惯害羞的感觉…"
    },
    {
      "idx": 18,
      "seg_id": 18,
      "t0": 170.92,
      "t1": 178.45,
      "zh": "感觉稍微…怎么说呢…好像放下了某种束缚似的…"
    },
    {
      "idx": 19,
      "seg_id": 19,
      "t0": 179.83,
      "t1": 185.72,
      "zh": "接下来…我还想做更加大胆的事情…"
    }
