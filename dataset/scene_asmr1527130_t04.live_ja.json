    },
    {
      "seg_id": 4,
      "t0": 20.91,
      "t1": 25.5,
      "official_ja": "",
      "live_ja": "もっと照れくさくなりました。",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 5,
      "t0": 25.5,
      "t1": 29.58,
      "official_ja": "",
      "live_ja": "している間に、期待通り…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 6,
      "t0": 29.58,
      "t1": 33.15,
      "official_ja": "",
      "live_ja": "慣れてくるかもしれませんが…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 7,
      "t0": 34.17,
      "t1": 38.76,
      "official_ja": "",
      "live_ja": "せっかく準備したのに、話してばかりはダメですよ",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 8,
      "t0": 38.76,
      "t1": 42.33,
      "official_ja": "",
      "live_ja": "よね?それじゃあ…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 9,
      "t0": 42.33,
      "t1": 46.92,
      "official_ja": "",
      "live_ja": "そちらの木が変わる前に、始めてしまいます",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 10,
      "t0": 48.45,
      "t1": 52.02,
      "official_ja": "",
      "live_ja": "なので、まずは…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 11,
      "t0": 53.04,
      "t1": 56.61,
      "official_ja": "",
      "live_ja": "私の…膝に…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 12,
      "t0": 56.61,
      "t1": 60.18,
      "official_ja": "",
      "live_ja": "頭を乗せてもらえると…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 13,
      "t0": 60.69,
      "t1": 64.26,
      "official_ja": "",
      "live_ja": "…そう。どう?",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 14,
      "t0": 81.09,
      "t1": 86.7,
      "official_ja": "",
      "live_ja": "ふふっ、いざ膝枕の恰好になると…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 15,
      "t0": 87.21,
      "t1": 90.78,
      "official_ja": "",
      "live_ja": "もっと緊張してしまいますね",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 16,
      "t0": 90.78,
      "t1": 94.35,
      "official_ja": "",
      "live_ja": "私の方から言ったことなのに…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 17,
      "t0": 95.88,
      "t1": 99.45,
      "official_ja": "",
      "live_ja": "ん…すぅ…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 18,
      "t0": 99.96,
      "t1": 105.57,
      "official_ja": "",
      "live_ja": "はあ…少しだけ、こちらの落ち着く時間を",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 19,
      "t0": 105.57,
      "t1": 109.14,
      "official_ja": "",
      "live_ja": "もらえると、ありがたいです",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 20,
      "t0": 109.14,
      "t1": 112.71,
      "official_ja": "",
      "live_ja": "ほんの数秒だけなので…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 21,
      "t0": 122.91,
      "t1": 127.5,
      "official_ja": "",
      "live_ja": "すみません。お待たせしてしまって",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 22,
      "t0": 128.52,
      "t1": 132.09,
      "official_ja": "",
      "live_ja": "それじゃあ、はじめまし",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 23,
      "t0": 132.6,
      "t1": 137.7,
      "official_ja": "",
      "live_ja": "準備したのは、耳かき棒と綿棒ですけど…",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 24,
      "t0": 139.74,
      "t1": 143.31,
      "official_ja": "",
      "live_ja": "最初は、耳を鳴らしたいのに",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 25,
      "t0": 144.33,
      "t1": 147.39,
      "official_ja": "",
      "live_ja": "綿棒から扱います",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 26,
      "t0": 147.39,
