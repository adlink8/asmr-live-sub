    },
    {
      "seg_id": 2,
      "t0": 12.24,
      "t1": 15.81,
      "official_ja": "",
      "live_ja": "してもいいってことですよね?",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 3,
      "t0": 16.32,
      "t1": 20.91,
      "official_ja": "",
      "live_ja": "ふふ…いざ始めるとなると…",
      "excluded": false,
