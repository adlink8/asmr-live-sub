    {
      "idx": 1,
      "seg_id": 1,
      "t0": 3.95,
      "t1": 9.62,
      "zh": "一直躺着等我呢…也就是说…"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 11.85,
      "t1": 14.41,
