  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 3.16,
      "t1": 9.22,
      "zh": "刮了绒毛、洗了耳朵、做了按摩……"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 9.24,
      "t1": 16.99,
      "zh": "虽然做了各种各样的事，但说到耳朵，重点还没做吧——"
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 17.02,
      "t1": 21.08,
      "zh": "接下来要做什么，知道了吧？"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 24.78,
      "t1": 27.88,
      "zh": "对，就是这个。"
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 27.9,
      "t1": 32.69,
      "zh": "到我们都喜欢的掏耳了哦。"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 34.32,
      "t1": 37.03,
      "zh": "先去选一下工具啦—"
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 42.36,
      "t1": 46.34,
      "zh": "要选哪个呢……"
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 47.66,
      "t1": 52.92,
      "zh": "到现在也用了各种各样的道具……"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 52.94,
      "t1": 57.06,
      "zh": "掏耳朵的话还是普通的比较好呢……"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 69.96,
      "t1": 74.28,
      "zh": "好—的。久等啦。"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 74.31,
      "t1": 80.34,
      "zh": "把传统的棉棒和梵天掏耳棒拿来了。"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 80.37,
      "t1": 84.03,
      "zh": "今天也用了很多罕见的道具"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 84.06,
      "t1": 89.55,
      "zh": "这里就特意选了比较正统的东西呢。"
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 89.57,
      "t1": 94.33,
      "zh": "这样，我也能更集中地来掏耳。"
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 97.3,
      "t1": 102.56,
      "zh": "嗯哼哼。要到更近的地方打扰了哦。"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 116.74,
      "t1": 119.03,
      "zh": "从棉棒开始吧。"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 137.0,
      "t1": 146.72,
      "zh": "那么，棉棒要进入耳朵了，请放松下来哦……"
    }
