{
  "script_file": "rn02_03_「在膝枕上按摩眼部＆颈部（吹气）」.wav.vtt",
  "source": "dlsite_builtin_vtt",
  "total_segments": 24,
  "built_at": "2026-09-25 09:12:35",
  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 13.01,
      "t1": 16.15,
      "zh": "会有种像是浑身被蚁爬的痒痒感吧……"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 16.15,
      "t1": 21.97,
      "zh": "但是 那都是肌肉僵硬被舒缓的证明哦"
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 36.96,
      "t1": 40.4,
      "zh": "哟……咻……"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 59.41,
      "t1": 63.82,
      "zh": "之后 再轻轻来几次……"
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 68.4,
      "t1": 72.24,
      "zh": "揉捏揉捏……"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 81.02,
      "t1": 83.35,
      "zh": "来吧……"
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 90.5,
      "t1": 94.38,
      "zh": "好了 这样就行了吧？"
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 94.8,
      "t1": 100.1,
      "zh": "那你睁开眼 试着多眨几次眼看看"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 110.58,
      "t1": 115.17,
      "zh": "真是的……你眨得那么厉害 又要累到眼睛啦"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 115.17,
      "t1": 120.12,
      "zh": "不过 这也侧面说明 你的眼睛已经变得很轻松了 对吧"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 120.12,
      "t1": 123.18,
      "zh": "啊……要给我谢礼？"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 124.64,
      "t1": 128.19,
      "zh": "你这人真是动不动就想着要酬谢别人呀"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 128.19,
      "t1": 133.75,
      "zh": "不用啦 这全都是我自己喜欢才会去做的事而已"
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 134.6,
      "t1": 136.64,
      "zh": "嗯……但是……"
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 137.07,
      "t1": 140.86,
      "zh": "要是你无论如何都想要谢谢我的话"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 140.86,
      "t1": 145.39,
      "zh": "那你能再稍微陪我做点什么吗？"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 146.49,
      "t1": 150.91,
      "zh": "其实 除了眼睛或脖子的按摩以外……"
    },
    {
      "idx": 18,
      "seg_id": 18,
      "t0": 150.91,
      "t1": 157.23,
      "zh": "吃完饭之后 我实际上是想给你做这件事的……"
    },
    {
      "idx": 19,
      "seg_id": 19,
      "t0": 157.23,
      "t1": 161.69,
      "zh": "要是你对我有一点感激之情的话……"
    },
    {
      "idx": 20,
      "seg_id": 20,
      "t0": 162.1,
      "t1": 164.77,
      "zh": "就在我说完转身后"
    },
    {
      "idx": 21,
      "seg_id": 21,
      "t0": 164.77,
      "t1": 169.66,
      "zh": "将你的右耳转向我这边吧"
    },
    {
      "idx": 22,
      "seg_id": 22,
      "t0": 172.71,
      "t1": 174.68,
      "zh": "那么……"
    },
    {
      "idx": 23,
      "seg_id": 23,
      "t0": 174.68,
      "t1": 178.83,
      "zh": "三二一……"
    },
    {
      "idx": 24,
      "seg_id": 24,
      "t0": 179.58,
      "t1": 185.28,
      "zh": "转身吧……"
    }
  ],
