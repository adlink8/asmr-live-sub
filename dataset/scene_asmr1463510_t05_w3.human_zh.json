  "segments": [
    {
      "idx": 1,
      "seg_id": 1,
      "t0": 38.16,
      "t1": 39.64,
      "zh": "感覺的到嗎?"
    },
    {
      "idx": 2,
      "seg_id": 2,
      "t0": 43.32,
      "t1": 45.09,
      "zh": "終於..."
    },
    {
      "idx": 3,
      "seg_id": 3,
      "t0": 46.69,
      "t1": 49.58,
      "zh": "來吧...請告訴我。"
    },
    {
      "idx": 4,
      "seg_id": 4,
      "t0": 51.78,
      "t1": 56.14,
      "zh": "我、我的力量是什麼感覺呢。"
    },
    {
      "idx": 5,
      "seg_id": 5,
      "t0": 60.49,
      "t1": 63.09,
      "zh": "自己正在融化的感覺。"
    },
    {
      "idx": 6,
      "seg_id": 6,
      "t0": 65.64,
      "t1": 66.66,
      "zh": "原來如此。"
    },
    {
      "idx": 7,
      "seg_id": 7,
      "t0": 67.53,
      "t1": 70.7,
      "zh": "正如同是在夢境中融為一體。"
    },
    {
      "idx": 8,
      "seg_id": 8,
      "t0": 71.65,
      "t1": 76.7,
      "zh": "你正在返回到我當中的證據。"
    },
    {
      "idx": 9,
      "seg_id": 9,
      "t0": 78.94,
      "t1": 87.25,
      "zh": "那是非常的舒適...像是與宇宙合為一體那般的感覺。"
    },
    {
      "idx": 10,
      "seg_id": 10,
      "t0": 149.2,
      "t1": 154.78,
      "zh": "在你之中的常識、價值觀、信仰，"
    },
    {
      "idx": 11,
      "seg_id": 11,
      "t0": 156.57,
      "t1": 158.74,
      "zh": "那些有形的事物，"
    },
    {
      "idx": 12,
      "seg_id": 12,
      "t0": 159.62,
      "t1": 162.36,
      "zh": "在我面前皆毫無意義。"
    },
    {
      "idx": 13,
      "seg_id": 13,
      "t0": 164.02,
      "t1": 165.97,
      "zh": "無可理解的言行、"
    },
    {
      "idx": 14,
      "seg_id": 14,
      "t0": 166.89,
      "t1": 168.95,
      "zh": "無法形容的意志、"
    },
    {
      "idx": 15,
      "seg_id": 15,
      "t0": 169.85,
      "t1": 172.28,
      "zh": "那便是我們的本質。"
    },
    {
      "idx": 16,
      "seg_id": 16,
      "t0": 173.86,
      "t1": 177.9,
      "zh": "光是觸碰，所有的事物都將失去形狀。"
    },
    {
      "idx": 17,
      "seg_id": 17,
      "t0": 179.91,
      "t1": 181.84,
      "zh": "連你自身也一樣。"
    }
  ],
