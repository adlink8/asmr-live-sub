      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 15,
      "t0": 76.5,
      "t1": 82.11,
      "official_ja": "あなたの好きな、このいい生前で…",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 16,
      "t0": 82.11,
      "t1": 85.68,
