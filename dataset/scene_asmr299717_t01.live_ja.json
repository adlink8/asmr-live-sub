      "official_ja": "こういうの好きなんだ?",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 4,
      "t0": 23.97,
      "t1": 28.05,
      "official_ja": "あ、そうだった。自己紹介まだだ",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 5,
      "t0": 29.58,
      "t1": 34.17,
      "official_ja": "私は、魔界から来た悪魔の女王",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 6,
      "t0": 34.17,
      "t1": 37.74,
      "official_ja": "周防、パトラだよ。今日は…",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 7,
      "t0": 37.74,
      "t1": 41.82,
      "official_ja": "人間のことを知るために魔界からやってきたの",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 8,
      "t0": 42.33,
      "t1": 46.41,
      "official_ja": "バナ女王になるための試験みたいなものなんだけど…",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 9,
      "t0": 46.41,
      "t1": 49.98,
      "official_ja": "人間の生態を知りたいっていうか…",
      "live_ja": "",
      "excluded": false,
      "exclude_reason": ""
    },
    {
      "seg_id": 10,
      "t0": 49.98,
      "t1": 54.57,
      "official_ja": "人間はどんな時に癒されるのか研究しに来たんだ",
