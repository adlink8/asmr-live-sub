{"ts": "17:21:57.597", "kind": "mt", "live": true, "seg_id": 12, "ja": "天使の天音奏多です。実はボクも…", "zh": "我是天使天音奏多。其实我也是……", "zh_empty": false, "zh_len": 16, "zh_refusal": null, "asr_s": 0.55, "mt_s": 0.529, "q_mt": 0, "q_late": 0, "prompt_tokens": 82, "completion_tokens": 11, "pred_ms": null, "prompt_ms": null, "pred_per_s": null, "gen_s": 0.529, "in_chars": 16, "out_chars": 16, "max_tokens": 56}
