{"ts": "17:21:58.794", "kind": "mt", "live": true, "seg_id": 14, "ja": "まって二人して男女二人知ってるんだろちょっと", "zh": "等等你们两个都认识一男一女吧。", "zh_empty": false, "zh_len": 15, "zh_refusal": null, "asr_s": 0.648, "mt_s": 0.531, "q_mt": 0, "q_late": 0, "prompt_tokens": 79, "completion_tokens": 11, "pred_ms": null, "prompt_ms": null, "pred_per_s": null, "gen_s": 0.531, "in_chars": 22, "out_chars": 15, "max_tokens": 74}
