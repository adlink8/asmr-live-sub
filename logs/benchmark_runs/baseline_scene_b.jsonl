{"ts": "15:33:17.007", "kind": "asr", "role": "late", "seg_id": 10, "t_start": 78.0, "t_end": 87.2, "audio_s": 9.69, "rms": 0.03202, "asr_s": 0.44, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "では杏鈴ちゃん、ボクのやり方をよく見ててくださいね。はいっ!それじゃ、はじめは…", "start": 0, "end": 0.96, "avg_logprob": -0.259, "no_speech_prob": 0, "compression_ratio": 1.146, "drop": null}], "ja": "では杏鈴ちゃん、ボクのやり方をよく見ててくださいね。はいっ!それじゃ、はじめは…", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
