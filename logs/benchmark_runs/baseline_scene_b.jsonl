{"ts": "15:33:14.069", "kind": "asr", "role": "late", "seg_id": 2, "t_start": 8.6, "t_end": 17.3, "audio_s": 9.18, "rms": 0.03732, "asr_s": 0.418, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "あとで一緒に庭のお散歩も、しましょうか。で・す・が、今はまだダメです", "start": 0, "end": 0.18, "avg_logprob": -0.1908, "no_speech_prob": 0, "compression_ratio": 1.133, "drop": null}], "ja": "あとで一緒に庭のお散歩も、しましょうか。で・す・が、今はまだダメです", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
{"ts": "15:33:14.464", "kind": "asr", "role": "late", "seg_id": 3, "t_start": 17.8, "t_end": 29.0, "audio_s": 11.73, "rms": 0.03335, "asr_s": 0.395, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "お客様は疲れきっているので、まずはそれをしっかり癒してからです。は、はいー、あずき", "start": 0, "end": 0.96, "avg_logprob": -0.3097, "no_speech_prob": 0, "compression_ratio": 1.309, "drop": null}], "ja": "お客様は疲れきっているので、まずはそれをしっかり癒してからです。は、はいー、あずき", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
{"ts": "15:33:14.825", "kind": "asr", "role": "late", "seg_id": 4, "t_start": 29.5, "t_end": 33.6, "audio_s": 3.06, "rms": 0.05979, "asr_s": 0.362, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "私も、勉強させていただきます", "start": 0, "end": 3.06, "avg_logprob": -0.4436, "no_speech_prob": 0, "compression_ratio": 0.792, "drop": null}], "ja": "私も、勉強させていただきます", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
{"ts": "15:33:15.137", "kind": "asr", "role": "late", "seg_id": 5, "t_start": 39.2, "t_end": 44.8, "audio_s": 4.59, "rms": 0.03213, "asr_s": 0.312, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "わくわく…どうされました?お客様", "start": 0, "end": 0.06, "avg_logprob": -0.3311, "no_speech_prob": 0, "compression_ratio": 0.868, "drop": null}], "ja": "わくわく…どうされました?お客様", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
{"ts": "15:33:15.482", "kind": "asr", "role": "late", "seg_id": 6, "t_start": 45.3, "t_end": 52.5, "audio_s": 6.12, "rms": 0.04136, "asr_s": 0.345, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "ああ、アズちゃんはなんでこっちを輝いた目で見ているのか、ですか?", "start": 0, "end": 0.48, "avg_logprob": -0.2194, "no_speech_prob": 0, "compression_ratio": 1.133, "drop": null}], "ja": "ああ、アズちゃんはなんでこっちを輝いた目で見ているのか、ですか?", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
{"ts": "15:33:15.818", "kind": "asr", "role": "late", "seg_id": 7, "t_start": 53.0, "t_end": 57.6, "audio_s": 3.57, "rms": 0.03827, "asr_s": 0.334, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "アズちゃんはまだ天使見習いなんですよ", "start": 0, "end": 0.06, "avg_logprob": -0.2878, "no_speech_prob": 0, "compression_ratio": 0.857, "drop": null}], "ja": "アズちゃんはまだ天使見習いなんですよ", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
{"ts": "15:33:16.227", "kind": "asr", "role": "late", "seg_id": 8, "t_start": 58.1, "t_end": 66.8, "audio_s": 9.18, "rms": 0.04333, "asr_s": 0.41, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "この宿にもついこの間入ったばっかりなんです。だから、実際のおもてなしを見せるのも初めてなん", "start": 0, "end": 9.18, "avg_logprob": -0.1275, "no_speech_prob": 0, "compression_ratio": 1.274, "drop": null}], "ja": "この宿にもついこの間入ったばっかりなんです。だから、実際のおもてなしを見せるのも初めてなん", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 17}
