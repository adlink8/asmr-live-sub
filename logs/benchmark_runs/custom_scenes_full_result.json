    "tokens_p50": 0.0,
    "subtitles": [
      {
        "seg_id": 0,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.573,
        "mt_s": 0.854,
        "delay": 6.02,
        "tok_s": 0.0,
        "ja": "始まりましたー!急にはじまるじゃん、わー!",
        "zh": "开始了！突然就开始了，哇——！"
      },
      {
        "seg_id": 1,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.339,
        "mt_s": 0.619,
        "delay": 5.55,
        "tok_s": 0.0,
        "ja": "急にはじまった…うはははっ!じゃあ、ツタのあずき",
        "zh": "突然开始的……哇哈哈哈！那么，藤蔓的红豆……"
      },
      {
        "seg_id": 2,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.774,
        "mt_s": 0.692,
        "delay": 6.06,
        "tok_s": 0.0,
        "ja": "綺ちゃん、叶太さん、クロエさんの順番で、挨拶をお願いしゃい",
        "zh": "请按照小绮、叶太先生、克萝伊小姐的顺序打招呼。"
      },
      {
        "seg_id": 3,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.556,
        "mt_s": 0.425,
        "delay": 6.08,
        "tok_s": 0.0,
        "ja": "はい、えー、天使みだらいの小豆です",
        "zh": "是的，呃～我是天使般淫荡的小豆。"
      },
      {
        "seg_id": 4,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.61,
        "asr_s": 0.8,
        "mt_s": 0.458,
        "delay": 6.87,
        "tok_s": 0.0,
        "ja": "おすばらしい天使いならいの小豆ー、はい今日はなんだか…すず離",
        "zh": "天使般的小豆，今天感觉有点……铃离"
      },
      {
        "seg_id": 6,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.29,
        "mt_s": 0.649,
        "delay": 6.04,
        "tok_s": 0.0,
        "ja": "これちょっとね、ちょっとね。そういう時期にちょっととってます",
        "zh": "这个，我稍微，稍微一点。在这样的时期稍微拿了一点。"
      },
      {
        "seg_id": 7,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.672,
        "mt_s": 0.696,
        "delay": 5.96,
        "tok_s": 0.0,
        "ja": "そうですよね、正直バレちゃう。来ちゃっていますよね。でも、ちゃんと、あの…",
        "zh": "是啊，老实说，我早就知道了。你来了呢。不过，那个……"
      },
      {
        "seg_id": 8,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 3.06,
        "asr_s": 0.699,
        "mt_s": 0.536,
        "delay": 4.29,
        "tok_s": 0.0,
        "ja": "なんだ、あの本編マネ。ASMRの方はね",
        "zh": "模仿什么本篇啊？ASMR的部分倒是……"
      },
      {
        "seg_id": 9,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.559,
        "mt_s": 0.698,
        "delay": 5.85,
        "tok_s": 0.0,
        "ja": "もう、ね。素晴らしい…声で。クリアな時に撮ってます",
        "zh": "真是的，好棒的声音……我都是在她声音最清澈的时候录的。"
      },
      {
        "seg_id": 10,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.698,
        "mt_s": 0.58,
        "delay": 5.87,
        "tok_s": 0.0,
        "ja": "辛、取れてますんで大丈夫なはず。安心してください",
        "zh": "我有把辛拿掉，应该没问题。请放心。"
      },
      {
        "seg_id": 11,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.584,
        "mt_s": 0.542,
        "delay": 5.72,
        "tok_s": 0.0,
        "ja": "はい、そして奏多さん、はーい!えーと…",
        "zh": "好的，那么奏多先生，请说！呃……"
      },
      {
        "seg_id": 12,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 3.06,
        "asr_s": 0.55,
        "mt_s": 0.529,
        "delay": 4.14,
        "tok_s": 0.0,
        "ja": "天使の天音奏多です。実はボクも…",
        "zh": "我是天使天音奏多。其实我也是……"
      },
      {
        "seg_id": 13,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.08,
        "asr_s": 0.548,
        "mt_s": 0.579,
        "delay": 5.21,
        "tok_s": 0.0,
        "ja": "今日さっき突然ちょっと熱が出て、鼻声です",
        "zh": "今天早上突然有点发烧，所以声音听起来有鼻音。"
      },
      {
        "seg_id": 14,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 3.57,
        "asr_s": 0.648,
        "mt_s": 0.531,
        "delay": 4.75,
        "tok_s": 0.0,
        "ja": "まって二人して男女二人知ってるんだろちょっと",
        "zh": "等等你们两个都认识一男一女吧。"
      },
      {
        "seg_id": 15,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.559,
        "mt_s": 0.561,
        "delay": 5.71,
        "tok_s": 0.0,
        "ja": "しらんかってよ!天使みな、天使みだらい?の、と、魚",
        "zh": "你不知道吗？天使们，天使们，鱼。"
      },
      {
        "seg_id": 16,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.604,
        "mt_s": 0.766,
        "delay": 6.47,
        "tok_s": 0.0,
        "ja": "沙汰さんがボクたちを救ってくれるということで…あ、マジ?なんも考えず来てんだけど、だっ",
        "zh": "沙汰先生要拯救我们……啊，真的吗？我什么都没想就来了，不过——"
      },
      {
        "seg_id": 17,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.786,
        "mt_s": 0.842,
        "delay": 6.22,
        "tok_s": 0.0,
        "ja": "ちょ、詳しくってほせー!あ、おケシ、あ、じゃ、電子見習いね!",
        "zh": "等、等等，我想要更详细的说明！啊，是吗，啊，那么，就是电子实习生咯？"
      },
      {
        "seg_id": 18,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.846,
        "mt_s": 0.696,
        "delay": 6.13,
        "tok_s": 0.0,
        "ja": "とーっても可愛くて、人気者の、そこもだっくらいちゃんにー",
        "zh": "超～级可爱，人见人爱的，我最心爱的妹妹——"
      },
      {
        "seg_id": 19,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.71,
        "mt_s": 0.581,
        "delay": 5.88,
        "tok_s": 0.0,
        "ja": "か、この人に甘えしもおねーさん!ぽよぽよぽ!",
        "zh": "这、这个人就是姐姐！我好想撒娇哦！"
      },
      {
        "seg_id": 20,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.596,
        "mt_s": 0.627,
        "delay": 5.81,
        "tok_s": 0.0,
        "ja": "おっぱきたぁ!正気、正気、また、グロエが!",
        "zh": "是奶子！？清醒，清醒，古萝耶又来了！"
      },
      {
        "seg_id": 21,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.654,
        "mt_s": 0.767,
        "delay": 6.01,
        "tok_s": 0.0,
        "ja": "しょとまた黒枝だったか。でもさ、これさ、ふたり本調子じゃないってなった",
        "zh": "是说，又是黑枝啊。不过，这下子我们两个都状态不佳了呢。"
      },
      {
        "seg_id": 22,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.779,
        "mt_s": 0.608,
        "delay": 5.98,
        "tok_s": 0.0,
        "ja": "ほんとに頑張んなきゃいけないじゃん。まあまあでもね、あの意外と待っ",
        "zh": "真的得好好努力才行。不过嘛，那个意外地等——"
      },
      {
        "seg_id": 23,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 3.57,
        "asr_s": 0.621,
        "mt_s": 0.605,
        "delay": 4.8,
        "tok_s": 0.0,
        "ja": "まだ元気ありますよ?ほんとですか?うん、ボクはまだいけま",
        "zh": "我还有精神哦？真的吗？嗯，我还行的。"
      },
      {
        "seg_id": 24,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.616,
        "mt_s": 0.85,
        "delay": 6.06,
        "tok_s": 0.0,
        "ja": "あ、じゃあやりますか?やっていきましょう!いやでもこれですね、あの…",
        "zh": "啊，那要来吗？就来吧！不过这个嘛，那个……"
      },
      {
        "seg_id": 25,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 3.06,
        "asr_s": 0.613,
        "mt_s": 0.27,
        "delay": 3.94,
        "tok_s": 0.0,
        "ja": "収録を終えての感想的なものを…",
        "zh": "关于录音结束后的感想…"
      },
      {
        "seg_id": 26,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.542,
        "mt_s": 0.539,
        "delay": 5.67,
        "tok_s": 0.0,
        "ja": "ちょっと、みんなにね伝えたいってとこなんですけど実はボクたち収録は",
        "zh": "其实我有件事想告诉大家，就是我们录音——"
      },
      {
        "seg_id": 27,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.551,
        "mt_s": 0.602,
        "delay": 5.74,
        "tok_s": 0.0,
        "ja": "あ、えー同時にやっておらず…うん、個人個人の",
        "zh": "啊，呃——不是同时进行……嗯，是每个人各自……"
      },
      {
        "seg_id": 28,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.613,
        "mt_s": 0.538,
        "delay": 6.25,
        "tok_s": 0.0,
        "ja": "感想ということになるんですけれどもー。そうすねー。ASMR",
        "zh": "关于感想呢，这个嘛——ASMR。"
      },
      {
        "seg_id": 29,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.08,
        "asr_s": 0.563,
        "mt_s": 0.54,
        "delay": 5.18,
        "tok_s": 0.0,
        "ja": "スタジオで撮ったのってボク初めてだったんだけど、二人ともどうでした?",
        "zh": "我第一次在摄影棚拍照，你们觉得怎么样？"
      },
      {
        "seg_id": 30,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.555,
        "mt_s": 0.56,
        "delay": 6.21,
        "tok_s": 0.0,
        "ja": "え、なんかね…あの、クリスマスのやつで撮っ",
        "zh": "咦，那个啊…就是圣诞节的那张照片。"
      },
      {
        "seg_id": 31,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.58,
        "mt_s": 0.651,
        "delay": 5.82,
        "tok_s": 0.0,
        "ja": "あ、ボイスかぁ。バイノーラルそう、撮って…うんうん",
        "zh": "啊，是声音吗？好像双声道，录下来……嗯嗯。"
      },
      {
        "seg_id": 32,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.677,
        "mt_s": 0.843,
        "delay": 6.62,
        "tok_s": 0.0,
        "ja": "そん時にも思ったんスけどあれ、移動砲大変だよね?いやいや、そうだい",
        "zh": "虽然当时我就这么觉得，不过移动炮台很辛苦吧？不不，是啊。"
      },
      {
        "seg_id": 33,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 3.57,
        "asr_s": 0.702,
        "mt_s": 0.42,
        "delay": 4.69,
        "tok_s": 0.0,
        "ja": "ええ、移動が大変で、ほんとに…実は",
        "zh": "是的，移动很辛苦，真的…其实"
      },
      {
        "seg_id": 34,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.591,
        "mt_s": 0.698,
        "delay": 6.39,
        "tok_s": 0.0,
        "ja": "れっちゃん難しいかなり移動するよね。見せたいよね、あの瞬間の体勢",
        "zh": "小玲的移动方式好复杂哦。真想让她看看那个瞬间的姿势。"
      },
      {
        "seg_id": 35,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.709,
        "mt_s": 0.631,
        "delay": 5.93,
        "tok_s": 0.0,
        "ja": "たしかに…見せたい、変な姿勢してたりするんで",
        "zh": "确实…因为会摆出奇怪的姿势，所以想让她看看。"
      },
      {
        "seg_id": 36,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 4.59,
        "asr_s": 0.656,
        "mt_s": 0.606,
        "delay": 5.85,
        "tok_s": 0.0,
        "ja": "あんま言うとアレなんですけど…はははっ!ちょっと裏側が見えすぎて…",
        "zh": "虽然说太多不太好……哈哈哈！有点看得太透彻了……"
      },
      {
        "seg_id": 37,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 5.1,
        "asr_s": 0.631,
        "mt_s": 0.724,
        "delay": 6.46,
        "tok_s": 0.0,
        "ja": "すぎちゃってそんなことなみんなのね、あのちょっと膝枕してますからちゃんとね",
        "zh": "过了一段时间，大家的呢，那个，我正躺在你的大腿上，请好好地"
      },
      {
        "seg_id": 38,
        "t0": 0.0,
        "t1": 0.0,
        "audio_s": 2.55,
        "asr_s": 0.702,
        "mt_s": 0.352,
        "delay": 3.6,
        "tok_s": 0.0,
        "ja": "そそそそ。え、あ、あずちゃんどうですか?",
        "zh": "是是是是。咦，小、小梓你呢？"
      }
    ]
  },
  {
    "title": "【场景二：随机节奏说话】蔚蓝档案 圣园未夜（忽快忽慢、随机停顿掏耳与互动，人声密度 66%）",
