{"ts": "12:57:43.802", "kind": "mt", "live": true, "seg_id": 13, "ja": "何してるんだよ、兄さん。早く早く", "zh": "你在做什么啊，哥哥。快点快点。", "zh_empty": false, "zh_len": 15, "zh_refusal": null, "asr_s": 0.469, "mt_s": 0.503, "q_mt": 0, "q_late": 0, "gen_s": 0.503, "ttft_ms": 203.2, "pred_ms": 299.6, "in_chars": 16, "out_chars": 15, "max_tokens": 56}
