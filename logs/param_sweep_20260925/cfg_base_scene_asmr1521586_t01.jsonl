{"ts": "13:21:17.308", "kind": "mt", "live": true, "seg_id": 5, "ja": "じゃーん、耳かきー。なんか恋人っぽいかな?", "zh": "锵锵——掏耳朵。这样是不是很像情侣啊？", "zh_empty": false, "zh_len": 19, "zh_refusal": null, "asr_s": 0.263, "mt_s": 0.267, "q_mt": 0, "q_late": 0, "gen_s": 0.267, "ttft_ms": 29.1, "pred_ms": 237.5, "in_chars": 21, "out_chars": 19, "max_tokens": 71}
