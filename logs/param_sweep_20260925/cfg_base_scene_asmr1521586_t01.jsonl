{"ts": "13:20:46.946", "kind": "asr", "role": "live", "seg_id": 2, "t_start": 16.32, "t_end": 23.97, "audio_s": 6.12, "rms": 0.01989, "asr_s": 0.267, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "ふふっ、前と変わんないか。まだ成り立てほやほやだし", "start": 0, "end": 0.54, "avg_logprob": -0.3166, "no_speech_prob": 0, "compression_ratio": 1.027, "drop": null}], "ja": "ふふっ、前と変わんないか。まだ成り立てほやほやだし", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 0, "q_late": 0, "batch": 1}
{"ts": "13:20:47.252", "kind": "mt", "live": true, "seg_id": 2, "ja": "ふふっ、前と変わんないか。まだ成り立てほやほやだし", "zh": "呵呵，还是跟以前一样吗？毕竟才刚成立没多久。", "zh_empty": false, "zh_len": 22, "zh_refusal": null, "asr_s": 0.267, "mt_s": 0.305, "q_mt": 0, "q_late": 0, "gen_s": 0.305, "ttft_ms": 29.6, "pred_ms": 275.1, "in_chars": 25, "out_chars": 22, "max_tokens": 80}
