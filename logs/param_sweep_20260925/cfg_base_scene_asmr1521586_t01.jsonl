{"ts": "13:21:36.363", "kind": "mt", "live": true, "seg_id": 7, "ja": "ちょっと言いたいことあるからー。キミの耳、聞こえやすくしとこうかなー、なーんて", "zh": "我有点话想说～就让我的耳朵变得比较灵光吧～开玩笑的啦～", "zh_empty": false, "zh_len": 27, "zh_refusal": null, "asr_s": 0.281, "mt_s": 0.402, "q_mt": 0, "q_late": 0, "gen_s": 0.402, "ttft_ms": 31.7, "pred_ms": 370.4, "in_chars": 39, "out_chars": 27, "max_tokens": 80}
