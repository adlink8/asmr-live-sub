{"ts": "12:42:36.041", "kind": "asr-batch", "olds": 0, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:36.575", "kind": "mt", "live": true, "seg_id": 0, "ja": "はーい、いらっしゃい、彼氏くん", "zh": "好～欢迎光临，男友先生。", "zh_empty": false, "zh_len": 12, "zh_refusal": null, "asr_s": 0.44, "mt_s": 0.534, "q_mt": 0, "q_late": 0, "gen_s": 0.533, "ttft_ms": 49.2, "pred_ms": 483.7, "in_chars": 15, "out_chars": 12, "max_tokens": 53}
{"ts": "12:42:36.612", "kind": "asr", "role": "live", "seg_id": 1, "t_start": 6.63, "t_end": 15.3, "audio_s": 7.65, "rms": 0.02739, "asr_s": 0.57, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "彼女の部屋ですよー。どう?彼氏として、私の部屋に入った感想は?", "start": 0, "end": 0.02, "avg_logprob": -0.1311, "no_speech_prob": 0, "compression_ratio": 1.011, "drop": null}], "ja": "彼女の部屋ですよー。どう?彼氏として、私の部屋に入った感想は?", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:37.324", "kind": "mt", "live": true, "seg_id": 1, "ja": "彼女の部屋ですよー。どう?彼氏として、私の部屋に入った感想は?", "zh": "这是我的房间哦～怎么样？身为男朋友，进入我房间的感想是？", "zh_empty": false, "zh_len": 28, "zh_refusal": null, "asr_s": 0.57, "mt_s": 0.712, "q_mt": 0, "q_late": 0, "gen_s": 0.712, "ttft_ms": 39.5, "pred_ms": 672.8, "in_chars": 31, "out_chars": 28, "max_tokens": 80}
{"ts": "12:42:37.340", "kind": "asr", "role": "live", "seg_id": 2, "t_start": 16.32, "t_end": 23.46, "audio_s": 6.12, "rms": 0.01989, "asr_s": 0.728, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "ふふっ、前と変わんないか。まだ成り立てほやほやだし", "start": 0, "end": 0.54, "avg_logprob": -0.3166, "no_speech_prob": 0, "compression_ratio": 1.027, "drop": null}], "ja": "ふふっ、前と変わんないか。まだ成り立てほやほやだし", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:37.984", "kind": "mt", "live": true, "seg_id": 2, "ja": "ふふっ、前と変わんないか。まだ成り立てほやほやだし", "zh": "呵呵，还是跟以前一样吗？毕竟才刚成立没多久。", "zh_empty": false, "zh_len": 22, "zh_refusal": null, "asr_s": 0.728, "mt_s": 0.643, "q_mt": 0, "q_late": 0, "gen_s": 0.643, "ttft_ms": 39.5, "pred_ms": 603.3, "in_chars": 25, "out_chars": 22, "max_tokens": 80}
{"ts": "12:42:38.016", "kind": "asr", "role": "live", "seg_id": 3, "t_start": 23.97, "t_end": 32.64, "audio_s": 7.65, "rms": 0.03141, "asr_s": 0.676, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "もう、いい加減慣れなよー…毎回が1回目みたいな緊張感じゃん", "start": 0, "end": 0.12, "avg_logprob": -0.2326, "no_speech_prob": 0, "compression_ratio": 0.934, "drop": null}], "ja": "もう、いい加減慣れなよー…毎回が1回目みたいな緊張感じゃん", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:38.395", "kind": "asr", "role": "live", "seg_id": 4, "t_start": 34.17, "t_end": 36.72, "audio_s": 1.53, "rms": 0.02588, "asr_s": 0.379, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "今日はね…", "start": 0, "end": 0.18, "avg_logprob": -0.7832, "no_speech_prob": 0, "compression_ratio": 0.625, "drop": null}], "ja": "今日はね…", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:38.899", "kind": "mt", "live": true, "seg_id": 3, "ja": "もう、いい加減慣れなよー…毎回が1回目みたいな緊張感じゃん", "zh": "你也差不多该习惯了吧……每次我都会紧张得像第一次一样。", "zh_empty": false, "zh_len": 27, "zh_refusal": null, "asr_s": 0.676, "mt_s": 0.884, "q_mt": 1, "q_late": 0, "gen_s": 0.884, "ttft_ms": 279.5, "pred_ms": 604.0, "in_chars": 29, "out_chars": 27, "max_tokens": 80}
{"ts": "12:42:38.923", "kind": "asr", "role": "live", "seg_id": 5, "t_start": 36.72, "t_end": 39.78, "audio_s": 2.04, "rms": 0.01481, "asr_s": 0.528, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "やること決めてあるの", "start": 0, "end": 0.02, "avg_logprob": -0.313, "no_speech_prob": 0, "compression_ratio": 0.833, "drop": null}], "ja": "やること決めてあるの", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:39.254", "kind": "mt", "live": true, "seg_id": 4, "ja": "今日はね…", "zh": "今天呢……", "zh_empty": false, "zh_len": 5, "zh_refusal": null, "asr_s": 0.379, "mt_s": 0.355, "q_mt": 1, "q_late": 0, "gen_s": 0.355, "ttft_ms": 36.5, "pred_ms": 318.2, "in_chars": 5, "out_chars": 5, "max_tokens": 23}
{"ts": "12:42:39.499", "kind": "mt", "live": true, "seg_id": 5, "ja": "やること決めてあるの", "zh": "已经决定好要做什么了", "zh_empty": false, "zh_len": 10, "zh_refusal": null, "asr_s": 0.528, "mt_s": 0.245, "q_mt": 0, "q_late": 0, "gen_s": 0.199, "ttft_ms": 54.0, "pred_ms": 144.9, "in_chars": 10, "out_chars": 10, "max_tokens": 38}
{"ts": "12:42:39.513", "kind": "asr", "role": "live", "seg_id": 6, "t_start": 39.78, "t_end": 45.39, "audio_s": 4.59, "rms": 0.01911, "asr_s": 0.59, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "彼氏彼女になった当日に、やることと言えば…", "start": 0, "end": 0.12, "avg_logprob": -0.1966, "no_speech_prob": 0, "compression_ratio": 0.875, "drop": null}], "ja": "彼氏彼女になった当日に、やることと言えば…", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:40.056", "kind": "mt", "live": true, "seg_id": 6, "ja": "彼氏彼女になった当日に、やることと言えば…", "zh": "成为男女朋友的当天，要说该做什么的话……", "zh_empty": false, "zh_len": 20, "zh_refusal": null, "asr_s": 0.59, "mt_s": 0.543, "q_mt": 0, "q_late": 0, "gen_s": 0.543, "ttft_ms": 246.0, "pred_ms": 297.2, "in_chars": 21, "out_chars": 20, "max_tokens": 71}
{"ts": "12:42:40.074", "kind": "asr", "role": "live", "seg_id": 7, "t_start": 46.41, "t_end": 53.55, "audio_s": 6.12, "rms": 0.0198, "asr_s": 0.561, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "じゃーん、耳かきー。なんか恋人っぽいかな?", "start": 0, "end": 0.12, "avg_logprob": -0.3177, "no_speech_prob": 0, "compression_ratio": 0.953, "drop": null}], "ja": "じゃーん、耳かきー。なんか恋人っぽいかな?", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:40.662", "kind": "mt", "live": true, "seg_id": 7, "ja": "じゃーん、耳かきー。なんか恋人っぽいかな?", "zh": "锵锵——掏耳朵。这样是不是很像情侣啊？", "zh_empty": false, "zh_len": 19, "zh_refusal": null, "asr_s": 0.561, "mt_s": 0.588, "q_mt": 0, "q_late": 0, "gen_s": 0.588, "ttft_ms": 254.7, "pred_ms": 333.6, "in_chars": 21, "out_chars": 19, "max_tokens": 71}
{"ts": "12:42:40.677", "kind": "asr", "role": "live", "seg_id": 8, "t_start": 55.59, "t_end": 62.73, "audio_s": 6.12, "rms": 0.02086, "asr_s": 0.603, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "期待と違った?へぇー何考えてたの?ふふっ", "start": 0, "end": 0.02, "avg_logprob": -0.3883, "no_speech_prob": 0, "compression_ratio": 0.903, "drop": null}], "ja": "期待と違った?へぇー何考えてたの?ふふっ", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:41.269", "kind": "mt", "live": true, "seg_id": 8, "ja": "期待と違った?へぇー何考えてたの?ふふっ", "zh": "和期待不一样？咦～你在想什么啊？呵呵。", "zh_empty": false, "zh_len": 19, "zh_refusal": null, "asr_s": 0.603, "mt_s": 0.591, "q_mt": 0, "q_late": 0, "gen_s": 0.591, "ttft_ms": 242.3, "pred_ms": 348.8, "in_chars": 20, "out_chars": 19, "max_tokens": 68}
{"ts": "12:42:41.303", "kind": "asr", "role": "live", "seg_id": 9, "t_start": 63.75, "t_end": 72.42, "audio_s": 7.65, "rms": 0.01736, "asr_s": 0.626, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "ちょっと言いたいことあるからー。キミの耳、聞こえやすくしとこうかなー、なーんて", "start": 0, "end": 0.18, "avg_logprob": -0.2259, "no_speech_prob": 0, "compression_ratio": 1.272, "drop": null}], "ja": "ちょっと言いたいことあるからー。キミの耳、聞こえやすくしとこうかなー、なーんて", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:41.758", "kind": "asr", "role": "live", "seg_id": 10, "t_start": 74.46, "t_end": 77.01, "audio_s": 1.53, "rms": 0.01807, "asr_s": 0.455, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "そう、大事なこと", "start": 0, "end": 0.06, "avg_logprob": -0.4337, "no_speech_prob": 0, "compression_ratio": 0.686, "drop": null}], "ja": "そう、大事なこと", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:42.314", "kind": "mt", "live": true, "seg_id": 9, "ja": "ちょっと言いたいことあるからー。キミの耳、聞こえやすくしとこうかなー、なーんて", "zh": "我有点话想说～就让我的耳朵变得比较灵光吧～开玩笑的啦～", "zh_empty": false, "zh_len": 27, "zh_refusal": null, "asr_s": 0.626, "mt_s": 1.011, "q_mt": 1, "q_late": 0, "gen_s": 1.011, "ttft_ms": 285.1, "pred_ms": 725.8, "in_chars": 39, "out_chars": 27, "max_tokens": 80}
{"ts": "12:42:42.354", "kind": "asr", "role": "live", "seg_id": 11, "t_start": 77.52, "t_end": 81.09, "audio_s": 2.55, "rms": 0.01794, "asr_s": 0.595, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "耳かき、終わったら言うね", "start": 0, "end": 0.3, "avg_logprob": -0.2961, "no_speech_prob": 0, "compression_ratio": 0.766, "drop": null}], "ja": "耳かき、終わったら言うね", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:42.743", "kind": "mt", "live": true, "seg_id": 10, "ja": "そう、大事なこと", "zh": "没错，这是很重要的事。", "zh_empty": false, "zh_len": 11, "zh_refusal": null, "asr_s": 0.455, "mt_s": 0.429, "q_mt": 1, "q_late": 0, "gen_s": 0.429, "ttft_ms": 40.0, "pred_ms": 388.6, "in_chars": 8, "out_chars": 11, "max_tokens": 32}
{"ts": "12:42:42.785", "kind": "asr", "role": "live", "seg_id": 12, "t_start": 84.15, "t_end": 87.72, "audio_s": 2.55, "rms": 0.01531, "asr_s": 0.431, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "きーぞ…どうぞ", "start": 0, "end": 0.06, "avg_logprob": -0.8434, "no_speech_prob": 0, "compression_ratio": 0.724, "drop": null}], "ja": "きーぞ…どうぞ", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:43.217", "kind": "mt", "live": true, "seg_id": 11, "ja": "耳かき、終わったら言うね", "zh": "挖完耳朵之后，我会告诉你。", "zh_empty": false, "zh_len": 13, "zh_refusal": null, "asr_s": 0.595, "mt_s": 0.474, "q_mt": 1, "q_late": 0, "gen_s": 0.474, "ttft_ms": 36.6, "pred_ms": 437.4, "in_chars": 12, "out_chars": 13, "max_tokens": 44}
{"ts": "12:42:43.377", "kind": "mt", "live": true, "seg_id": 12, "ja": "きーぞ…どうぞ", "zh": "请——请说。", "zh_empty": false, "zh_len": 6, "zh_refusal": null, "asr_s": 0.431, "mt_s": 0.159, "q_mt": 0, "q_late": 0, "gen_s": 0.159, "ttft_ms": 37.0, "pred_ms": 122.0, "in_chars": 7, "out_chars": 6, "max_tokens": 29}
{"ts": "12:42:43.406", "kind": "asr", "role": "live", "seg_id": 13, "t_start": 89.25, "t_end": 97.41, "audio_s": 8.16, "rms": 0.02561, "asr_s": 0.621, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "いいに決まってるじゃん。彼女だよ。膝でも太ももでも、どこでも触り放題…", "start": 0, "end": 0.26, "avg_logprob": -0.1741, "no_speech_prob": 0, "compression_ratio": 1.071, "drop": null}], "ja": "いいに決まってるじゃん。彼女だよ。膝でも太ももでも、どこでも触り放題…", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:44.211", "kind": "mt", "live": true, "seg_id": 13, "ja": "いいに決まってるじゃん。彼女だよ。膝でも太ももでも、どこでも触り放題…", "zh": "当然可以啊。她可是我的女朋友耶，不管是膝盖还是大腿，不管哪里都可以摸个够……", "zh_empty": false, "zh_len": 38, "zh_refusal": null, "asr_s": 0.621, "mt_s": 0.805, "q_mt": 0, "q_late": 0, "gen_s": 0.805, "ttft_ms": 280.7, "pred_ms": 524.2, "in_chars": 35, "out_chars": 38, "max_tokens": 80}
{"ts": "12:42:44.220", "kind": "asr", "role": "live", "seg_id": 14, "t_start": 105.57, "t_end": 112.71, "audio_s": 6.12, "rms": 0.01984, "asr_s": 0.814, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "耳かきしてる最中は、変なとこ触んないでねー。危ないから", "start": 0, "end": 0.18, "avg_logprob": -0.2108, "no_speech_prob": 0, "compression_ratio": 1.038, "drop": null}], "ja": "耳かきしてる最中は、変なとこ触んないでねー。危ないから", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:44.770", "kind": "asr", "role": "live", "seg_id": 15, "t_start": 114.75, "t_end": 118.32, "audio_s": 2.55, "rms": 0.02246, "asr_s": 0.549, "lang": "ja", "lang_p": 1, "nseg": 1, "segments": [{"text": "はーい、おかえりなさーい", "start": 0, "end": 0.06, "avg_logprob": -0.436, "no_speech_prob": 0, "compression_ratio": 0.9, "drop": null}], "ja": "はーい、おかえりなさーい", "drop": null, "seg_drops": null, "q_seg": 0, "q_mt": 1, "q_late": 0, "batch": 23}
{"ts": "12:42:45.019", "kind": "mt", "live": true, "seg_id": 14, "ja": "耳かきしてる最中は、変なとこ触んないでねー。危ないから", "zh": "挖耳朵的时候不要乱摸奇怪的地方哦——很危险的。", "zh_empty": false, "zh_len": 23, "zh_refusal": null, "asr_s": 0.814, "mt_s": 0.799, "q_mt": 1, "q_late": 0, "gen_s": 0.798, "ttft_ms": 281.7, "pred_ms": 516.0, "in_chars": 27, "out_chars": 23, "max_tokens": 80}
{"ts": "12:42:45.245", "kind": "mt", "live": true, "seg_id": 15, "ja": "はーい、おかえりなさーい", "zh": "好～欢迎回来。", "zh_empty": false, "zh_len": 7, "zh_refusal": null, "asr_s": 0.549, "mt_s": 0.226, "q_mt": 0, "q_late": 0, "gen_s": 0.226, "ttft_ms": 103.3, "pred_ms": 123.1, "in_chars": 12, "out_chars": 7, "max_tokens": 44}
